{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Nombre real registrado en Cloudflare Workers Builds para este repo —
	// confirmado por el propio CI en un aviso de deploy ("the CI system
	// expected 'portfolio'"), no una suposición. Cualquier otro valor aquí
	// da igual lo que ponga el `name` de package.json.
	"name": "portfolio",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// El binding de autorreferencia: el nombre del servicio tiene que
			// coincidir con el `name` de arriba.
			// ver https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfolio"
		}
	],
	"images": {
		// Optimización de imágenes de Cloudflare
		// ver https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
