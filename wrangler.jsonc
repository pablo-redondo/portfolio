{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pablo-redondo-portfolio",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// El binding de autorreferencia: el nombre del servicio tiene que
			// coincidir con el `name` de arriba, que a su vez es el nombre real
			// del Worker en Cloudflare — no el `name` de package.json, que es
			// otra cosa. El build que falló los tenía desincronizados: el
			// binding apuntaba a un Worker que no existía.
			// ver https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pablo-redondo-portfolio"
		}
	],
	"images": {
		// Optimización de imágenes de Cloudflare
		// ver https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
